# Copy this file to .env.local, review it, then load it with:
# set -a; source .env.local; set +a
#
# Never commit .env.local or put these values in config.yaml.

# LLM providers
export GITHUB_TOKEN=""
export ANTHROPIC_API_KEY=""
export OPENAI_API_KEY=""
export GEMINI_API_KEY=""

# Dashboard GitHub OAuth App
export GITHUB_OAUTH_CLIENT_ID=""
export GITHUB_OAUTH_CLIENT_SECRET=""
export GITHUB_OAUTH_REDIRECT_URI="http://127.0.0.1:8000/auth/callback"

# Optional browser/search provider
export BROWSER_API_KEY=""

# Optional external employee integrations
export GOOGLE_CLIENT_ID=""
export GOOGLE_CLIENT_SECRET=""
export MICROSOFT_CLIENT_ID=""
export MICROSOFT_CLIENT_SECRET=""
export LINKEDIN_CLIENT_ID=""
export LINKEDIN_CLIENT_SECRET=""
export X_CLIENT_ID=""
export X_CLIENT_SECRET=""
export META_APP_ID=""
export META_APP_SECRET=""
export GITHUB_INTEGRATION_TOKEN=""
